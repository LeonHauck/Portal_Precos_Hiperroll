# Portal de Preços Hiperroll — regras do Apache (HostGator)

Options -Indexes

# Arquivos que nunca devem ser baixados pelo navegador: ocultos (.env, .git...),
# banco, planilhas, scripts de manutenção, backups e os dados de preço/custo
# (servidos só para usuários logados via api/data.php).
<FilesMatch "(^\.|\.(sqlite3?|db|md|py|ps1|sh|xlsx|json|log|bak)$|^(data|data_backup)\.js$|_backup\.(html|css|js)$|^auth\.php$|^config\.local\.php$|^regras_comerciais\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

RedirectMatch 404 /\.git

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # CSP: só roda JavaScript de arquivos deste site (e a biblioteca de PDF do cdnjs); nada de código
    # escrito dentro do HTML. Mesma política do <meta> no Portal_Hiperroll_Final.html, mais frame-ancestors.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Depois de ativar o SSL gratuito (AutoSSL) no cPanel, descomente para forçar HTTPS:
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
