# Exemplo de variáveis de ambiente para desenvolvimento
# Copie este arquivo para `.env` e ajuste as senhas localmente.
#
# Observação: o backend PHP usa `.env` como fallback de login, mas a
# fonte principal de usuários/senhas é `users.json`. Mantenha `.env` fora
# do repositório e use-o apenas para desenvolvimento local.

# Usuário desenvolvedor padrão
LEON_USER=Leon
LEON_PASS=l24598

# Usuário supervisor padrão
GABRIEL_USER=Gabriel.Ferreira
GABRIEL_PASS=gf2026

# Adicione outras variáveis sensíveis aqui, por exemplo:
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=senha
